{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:monorepo",
  "outputDirectory": "dist",
  "installCommand": "npm install && cd modernization-platform && npm install",
  "rewrites": [
    { "source": "/mip/(.*)", "destination": "/mip/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
